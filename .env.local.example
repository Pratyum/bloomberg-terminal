# Upstash Redis connection details
# Both naming conventions are supported for backward compatibility
UPSTASH_REDIS_REST_URL="your_upstash_redis_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"
KV_REST_API_URL="your_upstash_redis_url_here"
KV_REST_API_TOKEN="your_upstash_redis_token_here"

# Yahoo Finance is used for market data (no API key required)
# Google News RSS is used for financial news (no API key required)

# OpenAI API key for AI features
OPENAI_API_KEY="your_openai_api_key_here"

# Allowed origins for API access (comma-separated list, no spaces)
# Example: https://bloomberg-terminal-nine.vercel.app,http://localhost:3000
ALLOWED_ORIGINS="https://bloomberg-terminal-nine.vercel.app"

# Supabase Configuration
# Required for database features (market data storage, rate limiting)
#
# Get these values from your Supabase project:
# 1. Go to Project Settings -> API
# 2. NEXT_PUBLIC_SUPABASE_URL: Find "Project URL" (e.g., https://xxxxx.supabase.co)
# 3. NEXT_PUBLIC_SUPABASE_ANON_KEY: Find "anon public" key in "Project API keys"
#
# Local development: Copy to .env.local and fill in your values
# Production: Configure these in your hosting provider's env settings (Vercel, etc.)
#
# Troubleshooting: If you see "Failed to fetch" errors, verify:
# - URL starts with https:// (not http://)
# - Key matches the anon key exactly (not the service_role key)
# - RLS policies allow the operations your app needs
NEXT_PUBLIC_SUPABASE_URL="your_supabase_url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Server-side only (do not prefix with NEXT_PUBLIC_ for security)
# Service role key bypasses RLS - only use in server-side code
# Get from: Project Settings -> API -> service_role (secret, not to be exposed)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
